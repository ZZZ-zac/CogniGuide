# Where subjects, materials, attempts and the RAG index live.
# Leave empty to use web/data. Windows example: D:\CogniGuide\data
DATA_DIR=

MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50

# Vision model for images and PDF pages. qwen-vl-max returns "Model not exist" on DashScope now.
VISION_MODEL=qwen3-vl-plus
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
